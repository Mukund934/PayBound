# PayBound — environment template.
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Razorpay TEST MODE credentials.
#
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key
# (make sure the dashboard's Test/Live toggle is on TEST before generating)
#
# RZP_KEY_ID **MUST** start with `rzp_test_`. PayBound asserts this before
# every outbound request and refuses to open a socket otherwise — a live key
# is rejected at runtime, not merely discouraged.
# ---------------------------------------------------------------------------
RZP_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Anthropic API key — used only by the agent under test and by offline corpus
# authoring. Not required for KG-1, for `verify.py`, or for the test suite.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional. Leave unset unless you know why you are changing it.
# ---------------------------------------------------------------------------
# PB_RUN_ID=
# PB_MAX_REFUND_PAISE_PER_RUN=200000
