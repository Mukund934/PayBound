# PayBound — environment template.
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Razorpay TEST MODE credentials.
#
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key
# (make sure the dashboard's Test/Live toggle is on TEST before generating)
#
# RZP_KEY_ID **MUST** start with `rzp_test_`. PayBound asserts this before
# every outbound request and refuses to open a socket otherwise — a live key
# is rejected at runtime, not merely discouraged.
# ---------------------------------------------------------------------------
RZP_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Model provider for the agent under test and for offline corpus authoring.
# Not required for KG-1, for `verify.py`, or for the test suite.
#
# The architecture lock specified claude-sonnet-5 (T1) and claude-opus-5 (T2).
# The project now uses Gemini instead; see IMPLEMENTATION_CONTRACT section 12
# for what that deviation does and does not change.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_PROJECT_NUMBER=000000000000

# Only if the project moves back to Anthropic for the agent under test.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional. Leave unset unless you know why you are changing it.
# ---------------------------------------------------------------------------
# PB_RUN_ID=
# PB_MAX_REFUND_PAISE_PER_RUN=200000
