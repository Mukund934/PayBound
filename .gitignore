# ---------------------------------------------------------------------------
# SECRETS — never commit. `.env.example` is the only env file that ships.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*_secret*
razorpay_keys*

# ---------------------------------------------------------------------------
# Spike / run output that may contain raw API responses with account detail.
# Curated evidence is committed deliberately, by path, from `evidence/`.
# ---------------------------------------------------------------------------
scratch/
spike_out/
*.local.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ---------------------------------------------------------------------------
# Local databases and logs (the committed evidence lives in evidence/)
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.log

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
node_modules/
playwright-report/
test-results/

# Generated by `pb demo`. The published run committed under evidence/ instead.
report.html

.vercel

# Copied into the static root by the Vercel buildCommand. The committed
# originals live at the repository root, where a test asserts showcase.html
# equals a fresh render. A second committed copy could drift from the first,
# so the deployment makes its copy at build time and never stores one.
public/showcase.html
public/report.html
