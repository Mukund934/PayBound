{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public && cp showcase.html report.html public/ && test -s public/showcase.html && test -s public/report.html",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "memory": 512,
      "maxDuration": 15,
      "excludeFiles": "{tests/**,docs/**,spike_out/**,.venv/**,**/__pycache__/**,**/*.pyc,public/**,*.md,*.html}"
    }
  },
  "rewrites": [
    { "source": "/showcase", "destination": "/showcase.html" },
    { "source": "/report", "destination": "/report.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
